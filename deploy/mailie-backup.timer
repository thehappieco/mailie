# Runs mailie-backup.service once a day. Enable it (systemctl enable --now
# mailie-backup.timer) only after a backup started by hand has succeeded.

[Unit]
Description=Daily Mailie database backup

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
# A day missed while the machine was off runs at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
