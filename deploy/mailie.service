# An example systemd unit for running Mailie from a binary, hardened.
# docs/self-hosting.md, "From a binary, with systemd", has the steps around it:
# the user, the binary, the console and the environment file.
#
# The paths are examples; change them together. The daemon's user is a system
# user of its own (mailie), the database is in the state directory systemd
# makes for it (/var/lib/mailie, 0700), and every secret is in an environment
# file only root can read.

[Unit]
Description=Mailie mail server (REST, MCP and the console)
Documentation=https://github.com/thehappieco/mailie/blob/main/docs/self-hosting.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=mailie
Group=mailie
ExecStart=/usr/local/bin/mailserver serve

# Where things are. The environment file overrides these, and holds
# MAIL_CREDENTIAL_KEY_HEX and the other secrets: root's, mode 0600. systemd
# reads it before the daemon starts, so the daemon's user never reads the file
# itself. Loopback only: a reverse proxy on this host terminates TLS.
Environment=MAIL_DATA_DIR=/var/lib/mailie
Environment=MAIL_HTTP_ADDR=127.0.0.1:8080
Environment=MAIL_WEB_DIR=/usr/local/share/mailie/console
EnvironmentFile=/etc/mailie/mailie.env
StateDirectory=mailie
StateDirectoryMode=0700
UMask=0077

Restart=on-failure
RestartSec=5s
# On SIGTERM the daemon allows itself 15 s to close its mailbox connections.
TimeoutStopSec=30s

# Hardening. The daemon needs its state directory, a listening socket, outbound
# connections to mail and OAuth servers, and nothing else: no capability, no
# device, no other user's files, no writable path outside the state directory
# and its private /tmp.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
