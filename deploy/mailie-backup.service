# An example systemd unit for `mailserver backup` beside mailie.service: an
# encrypted copy of the database uploaded to S3 (docs/backup.md). Started by
# mailie-backup.timer; enable the timer only once a run by hand has worked:
#
#   systemctl start mailie-backup.service && journalctl -u mailie-backup.service
#
# The paths are mailie.service's; change them together.

[Unit]
Description=Mailie encrypted database backup
Documentation=https://github.com/thehappieco/mailie/blob/main/docs/backup.md
# It reads the database beside the running daemon, and needs it running.
Requisite=mailie.service
After=mailie.service

[Service]
Type=oneshot
User=mailie
Group=mailie
ExecStart=/usr/local/bin/mailserver backup
Environment=MAIL_DATA_DIR=/var/lib/mailie
# MAIL_BACKUP_BUCKET, MAIL_BACKUP_KMS_KEY_ARN, MAIL_BACKUP_REGION and MAIL_ENV
# (the daemon's): none of the daemon's secrets, which a backup never needs.
# AWS credentials come from the SDK's default chain, never from this file.
EnvironmentFile=/etc/mailie/backup.env
UMask=0077

# The snapshot is in clear while it is encrypted: in a /tmp of this run's own.
PrivateTmp=yes
# The database is opened read-only, but SQLite still takes its read locks in
# mail.db-shm beside it.
ReadWritePaths=/var/lib/mailie
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
