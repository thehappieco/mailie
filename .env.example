# mailserver configuration.
#
# Copy to .env for local development. Anything already present in the real
# environment wins over this file, so a stale copy here cannot override a
# deployment. Never put a real credential in the copy you commit — .env is in
# .gitignore and gitleaks runs over the history in CI.

# --- required -------------------------------------------------------------

# Encrypts every stored OAuth refresh token and IMAP password. Without it the
# daemon refuses to start, because there is no safe fallback: the alternative
# to a key is plaintext credentials on disk.
#
#   openssl rand -hex 32
#
# Losing this key means every account has to be authorised again. Back it up
# wherever the rest of your secrets live.
MAIL_CREDENTIAL_KEY_HEX=

# --- where things live ----------------------------------------------------

# Database, lock file and attachment cache. Defaults to the user config
# directory (~/Library/Application Support/mailserver on macOS).
#MAIL_DATA_DIR=/var/lib/mailserver

# Loopback by default. This daemon can read several mailboxes and send mail as
# their owner, so exposing it beyond the machine is a deliberate act — and one
# that wants TLS in front of it.
#MAIL_HTTP_ADDR=127.0.0.1:8080

# Serve /metrics on its own listener, keeping operational data off the port
# that answers mail queries. Empty keeps it on MAIL_HTTP_ADDR.
#MAIL_METRICS_ADDR=127.0.0.1:9090

# --- OAuth clients --------------------------------------------------------
#
# These identify the application, not the mailbox: one registration serves
# every account of that provider. See README.md for how to create them.

# Google Cloud Console, OAuth client of type "Desktop app", scope
# https://mail.google.com/. The secret Google issues for a desktop client is
# not really secret — the loopback redirect and PKCE are what make the flow
# safe — but the token endpoint may ask for it.
#MAIL_GOOGLE_CLIENT_ID=
#MAIL_GOOGLE_CLIENT_SECRET=

# Entra ID app registration: multitenant plus personal accounts, platform
# "Mobile and desktop applications" with redirect http://localhost, public
# client flows allowed, no secret. Delegated permissions
# IMAP.AccessAsUser.All and SMTP.Send on Office 365 Exchange Online.
#MAIL_MICROSOFT_CLIENT_ID=
#MAIL_MICROSOFT_TENANT=common

# --- web console ----------------------------------------------------------
#
# The console is a static build (web/dist, the open console) the daemon serves
# from a directory on the same origin as the API, so the browser needs no CORS
# and the session token never has to be a cookie. See docs/console.md.

# Directory holding the built console. Empty serves the API only; a directory
# without an index.html is logged and ignored, never fatal.
#MAIL_WEB_DIR=web/dist

# The origin a browser uses to reach the console: scheme, host and optional
# port, no path. It is the only source for the web OAuth redirect
# (<origin>/oauth/return) and for invite links; nothing is ever derived from a
# request's Host header. http is accepted for localhost only, and prod requires
# https. With `npm run dev` in web/ this is the Vite server:
#MAIL_PUBLIC_URL=http://localhost:5174
#MAIL_PUBLIC_URL=https://mail.example.org

# The console's own OAuth registrations, beside the CLI's installed clients
# above: a Google "Web application" client and a Microsoft "Web" platform
# registration, each with a real secret and the redirect
# <MAIL_PUBLIC_URL>/oauth/return. Both halves or neither, and they need
# MAIL_PUBLIC_URL. The Microsoft one uses MAIL_MICROSOFT_TENANT.
#MAIL_GOOGLE_WEB_CLIENT_ID=
#MAIL_GOOGLE_WEB_CLIENT_SECRET=
#MAIL_MICROSOFT_WEB_CLIENT_ID=
#MAIL_MICROSOFT_WEB_CLIENT_SECRET=

# Allow mail accounts whose IMAP or SMTP host is a loopback, private,
# link-local or CGNAT address. Off by default: a host typed into the console
# is a server-side connection to wherever somebody chose. Checked on the
# resolved address every time a connection is made, so a name that resolves
# somewhere else later is caught too. Tests and a local Dovecot turn it on.
#MAIL_ACCOUNT_ALLOW_PRIVATE=false

# --- operational ----------------------------------------------------------

#MAIL_ENV=dev                 # prod refuses cleartext webhooks and the IMAP trace
#MAIL_LOG_LEVEL=info          # debug | info | warn | error
#MAIL_LOG_FORMAT=text         # json | text (json is the default in prod)

# The key the command-line tools present to a running daemon. The CLI is a REST
# client: only the daemon holds the sync workers and the OAuth callback
# listener, so it is the only process that can add an account.
#MAIL_ADMIN_KEY=

# The key `serve --mcp-stdio` acts with, for an MCP client that launches the
# daemon itself and so has no Authorization header to send. An API key created
# in the console (API keys & MCP); the daemon refuses to start with --mcp-stdio
# without a valid one. Never printed.
#MAIL_MCP_KEY=

# Serve MCP over Streamable HTTP at /mcp, beside the REST API. On by default.
# Off, /mcp answers the API's JSON 404 and only `serve --mcp-stdio` speaks MCP.
#MAIL_MCP_HTTP=true

# Mount the instance-key routes (/v1/apikeys). Off by default: an endpoint that
# mints credentials should not be answering by accident. `mailserver apikey
# create|list|revoke` are clients of these routes and need them on; with them
# off, the daemon answers 404 and the only way to issue a key is
# `apikey create --bootstrap` with the daemon stopped.
#MAIL_ADMIN_API=false

# --- consent ----------------------------------------------------------------
#
# The revisions of the texts a person agrees to in the console: what sync
# stores, Mailie changing their mailboxes, sending from them, and what a tool
# holding one of their API keys can do. The console names the revision of the
# text it showed, and only the one configured here is accepted. Changing one
# asks everybody again: a consent to another revision of actions or sending
# stops counting (they are refused) until they agree to the new text, while a
# consent to another revision of sync keeps their mailboxes syncing unless they
# turn it off. Keys keep the terms they were created under. Printable ASCII
# without spaces, at most 64 bytes. Change them only with the texts. The
# defaults are the texts of the console in web/; a deployment serving another
# console sets the ones its texts carry, or every agreement it sends is
# refused.
#MAIL_CONSENT_VERSION_SYNC=2026-10-open-sync
#MAIL_CONSENT_VERSION_ACTIONS=2026-10-open-actions
#MAIL_CONSENT_VERSION_SEND=2026-10-open-sending
#MAIL_CONSENT_VERSION_KEYS=2026-10-open-api-keys

# --- reading mail ---------------------------------------------------------
#
# Message text, attachments and originals are fetched from the mail server
# when someone opens them and are never stored. An attachment or an original
# is spooled whole under MAIL_DATA_DIR/tmp while it is being sent, and removed
# when the response ends. This bounds what those downloads hold there at once,
# on the disk that also holds the database; past it a download is answered
# 429 until another ends. One larger than the whole budget still goes through
# when nothing else is being downloaded.
#MAIL_DOWNLOAD_SPOOL_MAX_BYTES=1G

# Reserved for a body and attachment cache, which needs a new consent first;
# nothing reads them today.
#MAIL_CACHE_BODY_MAX_BYTES=512M
#MAIL_CACHE_ATTACH_MAX_BYTES=2G

# --- webhooks -------------------------------------------------------------
#
# Reserved: webhooks are not implemented yet, and nothing reads these today.
# Payloads will carry subjects and sender addresses, so HTTPS is required
# outside dev (prod refuses the first one), and private address space is
# refused unless you opt in, because a webhook is a server-side fetch of a URL
# somebody else chose.
#MAIL_WEBHOOK_ALLOW_HTTP=false
#MAIL_WEBHOOK_ALLOW_PRIVATE=false

# --- backups --------------------------------------------------------------
#
# Optional. `mailserver backup` reads its own variables and none of the
# daemon's secrets: all three are required, and there is no default region.
# See docs/backup.md for what it does and the AWS permissions it needs.
#MAIL_BACKUP_BUCKET=
#MAIL_BACKUP_KMS_KEY_ARN=
#MAIL_BACKUP_REGION=

# --- rarely needed --------------------------------------------------------

# Addresses whose X-Forwarded-For header is believed, as a comma-separated
# list of addresses or CIDR blocks. Leave empty unless a reverse proxy is in
# front; otherwise every caller would share one rate limit.
#MAIL_TRUSTED_PROXIES=

# Microsoft device-code flow, for a machine with no browser (`account add
# --device`). Off by default because Entra security defaults block it
# outright, and tenants created after July 2026 have it blocked with no way to
# allow it. Never offered to the web console.
#MAIL_MICROSOFT_DEVICE_CODE=false

# Reserved for the MCP tools that send, which are not implemented yet: ask MCP
# clients that support it to confirm each send interactively, on top of
# confirm=true. Off by default: it blocks non-interactive runs.
#MAIL_MCP_ELICIT_SEND=false

# Tee the raw IMAP protocol to the log. It contains the XOAUTH2 line, which is
# a live access token, so prod refuses it.
#MAIL_IMAP_DEBUG=false

# Key rotation. Set the new key in MAIL_CREDENTIAL_KEY_HEX with a new id, keep
# the old one here until `mailserver rewrap-credentials` has run; the daemon
# then no longer needs it. Keep every retired key and its id elsewhere for as
# long as any backup taken before the rotation is kept: a backup's credentials
# stay sealed under the key of its day, and restoring one needs that key here
# again (docs/backup.md). Format: <id>:<hex>,<id>:<hex>
#MAIL_CREDENTIAL_KEY_ID=1
#MAIL_CREDENTIAL_PREVIOUS_KEYS=
